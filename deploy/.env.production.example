# Copy to .env on the server (never commit real secrets)

# PostgreSQL — use Coolify Postgres internal URL, e.g.:
# Host=postgres;Port=5432;Database=tms_pro;Username=tms;Password=CHANGE_ME
TMS_CONNECTION_STRING=Host=YOUR_PG_HOST;Port=5432;Database=tms_pro;Username=tms;Password=CHANGE_ME

# Min 32 characters — generate: openssl rand -base64 48
TMS_JWT_KEY=REPLACE_WITH_32_PLUS_CHARACTER_SECRET_KEY

# First deploy only; set false after DB is migrated
Database__RunStartupMigrations=true
Database__FailOnMigrationError=false
DemoData__Enabled=false
Gps__AllowSimulator=false

# Public URL — no custom domain: use free nip.io subdomain (points to your VPS IP)
# Assigned TMS URL: http://tms.144.91.98.218.nip.io
Cors__Origins__0=http://tms.144.91.98.218.nip.io

# Leave 8080 for direct IP access; Coolify domain routing uses nip.io on port 80/443
TMS_WEB_PORT=8080

# Email notifications (Gmail SMTP)
# Prefer a Gmail App Password if 2FA is enabled: https://myaccount.google.com/apppasswords
Notifications__Smtp__Host=smtp.gmail.com
Notifications__Smtp__Port=587
Notifications__Smtp__Username=your@gmail.com
Notifications__Smtp__Password=YOUR_GMAIL_APP_PASSWORD
Notifications__Smtp__From=your@gmail.com
Notifications__Smtp__FromName=TMS Pro
Notifications__Smtp__UseSsl=true

# Optional SMS/WhatsApp (MSG91)
# Notifications__Msg91__AuthKey=
# Notifications__Msg91__SenderId=TMSPro
# Notifications__Msg91__FlowId=
